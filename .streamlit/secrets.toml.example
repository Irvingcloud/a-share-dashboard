# 复制成 secrets.toml 并填上自己的值（本地测试用；线上在 Streamlit Cloud 后台 Secrets 里粘同样内容）
# 千万不要把 secrets.toml 提交到 GitHub

HISTORY_BACKEND = "feishu"

APP_PASSWORD = "给你自己用的访问口令"

FEISHU_APP_ID = "cli_xxxxxxxxxxxx"
FEISHU_APP_SECRET = "xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FEISHU_APP_TOKEN = "xxxxxxxxxxxxxxxxxxxx"     # 多维表格链接里 /base/ 后面那串
FEISHU_TABLE_ID = "tblxxxxxxxxxxxx"
